# ---------------------------------------------------------------------------
# Supabase (PostgreSQL)
# ---------------------------------------------------------------------------
# Preencha com os dados do seu projeto: https://supabase.com/dashboard
# Sem estas variáveis o app roda em "modo demonstração" com dados locais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: usado apenas no servidor (criação de pedidos/agendamentos).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# WhatsApp
# ---------------------------------------------------------------------------
# Número com DDI + DDD, apenas dígitos. Ex.: 5511987654321
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999
# Mensagem padrão que abre o WhatsApp pelo link "Fale conosco".
NEXT_PUBLIC_WHATSAPP_MESSAGE=Olá! Gostaria de informações sobre os serviços da barbearia.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
